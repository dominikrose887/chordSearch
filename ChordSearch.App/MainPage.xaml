<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ChordSearch.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ChordSearch.App.Controls"
    xmlns:converters="using:ChordSearch.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:results="using:ChordSearch.Core.Results"
    xmlns:vm="using:ChordSearch.App.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToThicknessConverter x:Key="BoolToThickness" />
        <converters:StringPrefixConverter x:Key="StringPrefix" />
    </Page.Resources>

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid
            Padding="16,10,16,10"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Chord Search" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Text="{x:Bind ViewModel.ChordName, Mode=OneWay}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    Text="{x:Bind ViewModel.PitchClassText, Mode=OneWay}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Button
                    Command="{x:Bind ViewModel.PlayChordCommand}"
                    Content="Play"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button Command="{x:Bind ViewModel.PlayArpeggioCommand}" Content="Arpeggio" />
                <Button Command="{x:Bind ViewModel.StopMidiCommand}" Content="Stop" />
            </StackPanel>

            <Button
                Grid.Column="2"
                Click="SettingsButton_Click"
                Content="Settings"
                VerticalAlignment="Center" />
        </Grid>

        <Grid
            Grid.Row="1"
            Padding="16"
            ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Chord Builder only -->
            <Border
                Padding="14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Chord Builder" />

                        <TextBlock
                            FontSize="12"
                            Opacity="0.75"
                            Text="{x:Bind ViewModel.TheorySummary, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                        <TextBlock
                            FontSize="11"
                            Opacity="0.55"
                            Text="{x:Bind ViewModel.IntervalText, Mode=OneWay}" />

                        <TextBlock FontWeight="SemiBold" Text="1. Root" />
                        <GridView
                            IsItemClickEnabled="True"
                            ItemClick="RootGrid_ItemClick"
                            ItemsSource="{x:Bind ViewModel.Roots}"
                            SelectionMode="None">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid MaximumRowsOrColumns="6" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChipItem">
                                    <Border
                                        Width="46"
                                        Height="36"
                                        Margin="2"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        BorderThickness="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToThickness}}"
                                        CornerRadius="8">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Label}" />
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <TextBlock FontWeight="SemiBold" Text="2. Quality" />
                        <GridView
                            IsItemClickEnabled="True"
                            ItemClick="QualityGrid_ItemClick"
                            ItemsSource="{x:Bind ViewModel.Qualities}"
                            SelectionMode="None">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid MaximumRowsOrColumns="4" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChipItem">
                                    <Border
                                        MinWidth="68"
                                        Height="36"
                                        Margin="2"
                                        Padding="8,0"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        BorderThickness="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToThickness}}"
                                        CornerRadius="8">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Label}" />
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <TextBlock FontWeight="SemiBold" Text="3. Extensions" />
                        <GridView
                            IsItemClickEnabled="True"
                            ItemClick="ExtensionGrid_ItemClick"
                            ItemsSource="{x:Bind ViewModel.Extensions}"
                            SelectionMode="None">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid MaximumRowsOrColumns="4" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="vm:ChipItem">
                                    <Border
                                        MinWidth="58"
                                        Height="32"
                                        Margin="2"
                                        Padding="6,0"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        BorderThickness="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToThickness}}"
                                        CornerRadius="8">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Label}" />
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <TextBlock FontWeight="SemiBold" Text="4. Bass / Inversion" />
                        <GridView
                            IsItemClickEnabled="True"
                            ItemClick="BassGrid_ItemClick"
                            ItemsSource="{x:Bind ViewModel.BassOptions}"
                            SelectionMode="None">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid MaximumRowsOrColumns="4" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="vm:BassOption">
                                    <Border
                                        MinWidth="80"
                                        Height="32"
                                        Margin="2"
                                        Padding="6,0"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        BorderThickness="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BoolToThickness}}"
                                        CornerRadius="8">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind Label, Mode=OneWay}" />
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT: Fretboard primary + voicings -->
            <Grid Grid.Column="1" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="160" />
                </Grid.RowDefinitions>

                <Border
                    Padding="10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="2,0,2,8">
                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Fretboard" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Opacity="0.65"
                                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                        </Grid>
                        <controls:FretboardControl
                            x:Name="Fretboard"
                            Grid.Row="1"
                            Height="200"
                            HorizontalAlignment="Stretch"
                            MaxFret="{x:Bind ViewModel.MaxFrets, Mode=OneWay}"
                            Result="{x:Bind ViewModel.SelectedResult, Mode=OneWay}"
                            ScaleLengthMm="{x:Bind ViewModel.ScaleLengthMm, Mode=OneWay}"
                            Tuning="{x:Bind ViewModel.ActiveTuning, Mode=OneWay}" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    Padding="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Margin="4,0,0,0"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Voicings" />
                        <StackPanel
                            Grid.Row="1"
                            Margin="4,0,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <ToggleButton
                                Content="Open position"
                                IsChecked="{x:Bind ViewModel.FilterOpenPosition, Mode=TwoWay}" />
                            <ToggleButton
                                Content="No barre"
                                IsChecked="{x:Bind ViewModel.FilterNoBarre, Mode=TwoWay}" />
                            <ToggleButton
                                Content="Max 3 fingers"
                                IsChecked="{x:Bind ViewModel.FilterMaxThreeFingers, Mode=TwoWay}" />
                        </StackPanel>
                        <GridView
                            Grid.Row="2"
                            IsItemClickEnabled="True"
                            ItemClick="ResultList_ItemClick"
                            ItemsSource="{x:Bind ViewModel.Results}"
                            SelectedItem="{x:Bind ViewModel.SelectedResult, Mode=TwoWay}"
                            SelectionMode="Single">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid MaximumRowsOrColumns="8" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="results:VoicingResult">
                                    <Border
                                        Width="104"
                                        Margin="3"
                                        Padding="8,8,8,6"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <StackPanel Spacing="4">
                                            <controls:VoicingDiagramControl
                                                Width="72"
                                                Height="88"
                                                HorizontalAlignment="Center"
                                                Result="{x:Bind}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                TextAlignment="Center"
                                                TextWrapping="WrapWholeWords"
                                                Text="{x:Bind Label}" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="11"
                                                Opacity="0.6"
                                                Text="{x:Bind DifficultyLabel}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Settings dialog host content (shown via code) -->
        <ContentDialog
            x:Name="SettingsDialog"
            Title="Settings"
            CloseButtonText="Close"
            DefaultButton="Close"
            PrimaryButtonText="Apply tuning"
            PrimaryButtonClick="SettingsDialog_PrimaryClick">
            <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                <StackPanel Width="420" Spacing="14">
                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Neck" />
                    <ComboBox
                        MinWidth="280"
                        DisplayMemberPath="Label"
                        Header="Fret count"
                        ItemsSource="{x:Bind ViewModel.FretCountChoices}"
                        SelectedItem="{x:Bind ViewModel.SelectedFretCount, Mode=TwoWay}" />
                    <NumberBox
                        Header="Scale length (mm)"
                        Maximum="700"
                        Minimum="500"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.ScaleLengthMm, Mode=TwoWay}" />

                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Tuning" />
                    <ComboBox
                        MinWidth="280"
                        DisplayMemberPath="Name"
                        Header="Preset / saved"
                        ItemsSource="{x:Bind ViewModel.AvailableTunings}"
                        SelectedItem="{x:Bind ViewModel.ActiveTuning, Mode=TwoWay}" />
                    <NumberBox
                        Header="String count (4–8)"
                        Maximum="8"
                        Minimum="4"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.StringCount, Mode=TwoWay}" />
                    <Button Command="{x:Bind ViewModel.ApplyStringCountCommand}" Content="Apply string count" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Command="{x:Bind ViewModel.TransposeTuningDownCommand}"
                            Content="All strings −1"
                            ToolTipService.ToolTip="Transpose entire tuning down one semitone" />
                        <Button
                            Command="{x:Bind ViewModel.TransposeTuningUpCommand}"
                            Content="All strings +1"
                            ToolTipService.ToolTip="Transpose entire tuning up one semitone" />
                    </StackPanel>
                    <TextBox Header="Tuning name" Text="{x:Bind ViewModel.TuningName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.TuningStrings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TuningStringRow">
                                <Grid Margin="0,4" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{x:Bind StringNumber, Mode=OneWay, Converter={StaticResource StringPrefix}}" />
                                    <ComboBox
                                        Grid.Column="1"
                                        ItemsSource="{x:Bind PitchClassOptions}"
                                        SelectedItem="{x:Bind PitchClass, Mode=TwoWay}" />
                                    <NumberBox
                                        Grid.Column="2"
                                        Maximum="6"
                                        Minimum="0"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{x:Bind OctaveValue, Mode=TwoWay}" />
                                    <TextBlock
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind Display, Mode=OneWay}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Command="{x:Bind ViewModel.SaveCurrentTuningCommand}" Content="Save tuning as…" />

                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="MIDI" />
                    <ComboBox
                        MinWidth="280"
                        DisplayMemberPath="Name"
                        Header="Device"
                        ItemsSource="{x:Bind ViewModel.MidiDevices}"
                        SelectedItem="{x:Bind ViewModel.SelectedMidiDevice, Mode=TwoWay}" />
                    <Button Command="{x:Bind ViewModel.RefreshMidiDevicesCommand}" Content="Refresh devices" />
                    <Slider
                        Header="Velocity"
                        Maximum="127"
                        Minimum="20"
                        Value="{x:Bind ViewModel.Velocity, Mode=TwoWay}" />
                    <TextBlock
                        FontSize="12"
                        Opacity="0.75"
                        Text="{x:Bind ViewModel.MidiStatusText, Mode=OneWay}" />
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Page>
